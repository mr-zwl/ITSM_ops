# 全局环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env

# ===== 基础配置 =====
APP_ENV=development                # development | staging | production
APP_PORT=8080
APP_LOG_LEVEL=info

# ===== 关系数据库 (MySQL / PostgreSQL) =====
DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=itsm_ops
DB_USER=itsm
DB_PASSWORD=changeme

# ===== 时序数据库 =====
TSDB_TYPE=influxdb                 # influxdb | victoriametrics
TSDB_HOST=influxdb
TSDB_PORT=8086
TSDB_TOKEN=changeme
TSDB_ORG=itsm
TSDB_BUCKET=metrics

# ===== 缓存 =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 消息队列 =====
MQ_TYPE=rabbitmq                   # rabbitmq | kafka
MQ_HOST=rabbitmq
MQ_PORT=5672
MQ_USER=guest
MQ_PASSWORD=guest

# ===== 通知渠道 =====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ===== 采集 Agent =====
COLLECTOR_REPORT_ENDPOINT=http://backend:8080/api/v1/collect
COLLECTOR_CONCURRENCY=50
COLLECTOR_TIMEOUT=10s

# ===== JWT / 安全 =====
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRE=24h

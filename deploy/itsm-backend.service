[Unit]
Description=ITSM Ops Backend
After=network.target mysql.service

[Service]
Type=simple
ExecStart=/opt/itsm-ops-backend
WorkingDirectory=/opt/ITSM_ops/backend
Environment=DB_TYPE=mysql
Environment=DB_HOST=127.0.0.1
Environment=DB_PORT=3306
Environment=DB_USER=itsm
Environment=DB_PASSWORD=CHANGE_ME_PASSWORD
Environment=DB_NAME=itsm_ops
Environment=JWT_SECRET=CHANGE_ME_JWT_SECRET
Environment=LISTEN_ADDR=:8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
